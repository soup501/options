[Unit]
Description=Options web app (Next.js)
After=network.target docker.service

[Service]
Type=simple
WorkingDirectory=/var/www/options
User=options
EnvironmentFile=/etc/options.env
ExecStart=/var/www/options/node_modules/.bin/next start -p 3001 -H 127.0.0.1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
